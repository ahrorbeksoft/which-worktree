{
	"name": "which-worktree",
	"version": "0.1.1",
	"description": "Dev-server helpers for worktree-based development: Vite plugin that fixes fs.allow for symlinked node_modules, plus a worktree/branch badge for Svelte, React, Next.js and other frameworks.",
	"type": "module",
	"license": "ISC",
	"publishConfig": {
		"access": "public"
	},
	"svelte": "./src/index.js",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./src/vite.js"
		},
		"./WorktreeBadge.svelte": {
			"types": "./src/WorktreeBadge.svelte.d.ts",
			"svelte": "./src/WorktreeBadge.svelte",
			"default": "./src/WorktreeBadge.svelte"
		},
		"./react": {
			"types": "./src/react.d.ts",
			"default": "./src/react.jsx"
		},
		"./next": {
			"types": "./src/next.d.ts",
			"default": "./src/next.js"
		},
		"./badge": {
			"types": "./src/badge.d.ts",
			"default": "./src/badge.js"
		},
		"./info": {
			"types": "./src/info.d.ts",
			"default": "./src/info.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"scripts": {
		"release": "node scripts/publish.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahrorbeksoft/which-worktree.git"
	},
	"bugs": {
		"url": "https://github.com/ahrorbeksoft/which-worktree/issues"
	},
	"homepage": "https://github.com/ahrorbeksoft/which-worktree#readme",
	"keywords": [
		"vite",
		"vite-plugin",
		"svelte",
		"svelte5",
		"react",
		"nextjs",
		"git-worktree",
		"worktree",
		"dev-server"
	],
	"peerDependencies": {
		"react": ">=16.8.0",
		"svelte": "^5.0.0",
		"vite": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"vite": "^8.3.0"
	}
}
