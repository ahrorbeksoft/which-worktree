{
	"name": "which-worktree",
	"version": "0.1.1",
	"description": "Vite plugin that fixes dev-server fs.allow for symlinked node_modules (git worktrees, cow pastures) and shows a badge with the current branch/worktree name.",
	"type": "module",
	"license": "ISC",
	"publishConfig": {
		"access": "public"
	},
	"svelte": "./src/index.js",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./src/vite.js"
		},
		"./WorktreeBadge.svelte": {
			"types": "./src/WorktreeBadge.svelte.d.ts",
			"svelte": "./src/WorktreeBadge.svelte",
			"default": "./src/WorktreeBadge.svelte"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"scripts": {
		"release": "node scripts/publish.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahrorbeksoft/which-worktree.git"
	},
	"bugs": {
		"url": "https://github.com/ahrorbeksoft/which-worktree/issues"
	},
	"homepage": "https://github.com/ahrorbeksoft/which-worktree#readme",
	"keywords": [
		"vite",
		"vite-plugin",
		"svelte",
		"svelte5",
		"git-worktree",
		"worktree",
		"dev-server"
	],
	"peerDependencies": {
		"svelte": "^5.0.0",
		"vite": ">=5.0.0"
	},
	"devDependencies": {
		"vite": "^8.3.0"
	}
}
